# === Required ===
EMAIL_FROM=your-email@gmail.com
EMAIL_PASSWORD=your-gmail-app-password

# === MongoDB (optional - falls back to no persistence if not set) ===
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/
MONGO_DB=job_bot

# === LinkedIn (optional - improves LinkedIn scraping) ===
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# === Reddit API (optional - enables authenticated Reddit scraping) ===
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# === OpenAI (optional - enables AI-powered cover letters) ===
OPENAI_API_KEY=

# === Apply mode: assist (default, human-in-the-loop checklist) | off | auto (sends on the ATS pilot; needs `python -m playwright install chromium`; falls back to assist if the browser is unavailable) ===
APPLY_MODE=assist
APPLY_DAILY_LIMIT=5
# Set to 1 to pause all sends for the run (RF-9)
APPLY_PAUSED=0

# === Telegram (optional - for scraping Telegram channels) ===
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
